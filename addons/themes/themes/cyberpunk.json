{
  "name": "Cyberpunk",
  "author": "brodgar",
  "description": "Neon on near-black: chamfered cyan rules, magenta accents, corner brackets on every window and a monospaced terminal face throughout.",
  "about": "Art lives in themes/cyberpunk/ beside this file and is named by path, relative to the addon folder. Every PNG is authored in DESIGN pixels and at the exact size of the hole the client already draws in, so nothing is stretched out of shape and everything scales with the interface; rules are 1 px, because a 1.5x client multiplies whatever you write. The corner brackets are border.parts rather than art baked into the frame -- a motif inside an edge tile would repeat across the whole run. window.title's bg is a TRANSPARENT fill on purpose: the caption plate's box is the client's own scrollwork (77 design px tall, a quarter of the window wide), so no art fits it, while leaving the property out brings the stock plate back. And `*` keeps its own colour, because the field here is near-black and the client's own white text reads on it -- recolouring `*` would take the login screen with it. The two meter shapes are a 75x10 trough and a 15x93 box, so the trough art is TILED rather than stretched -- tiled, it repeats at its own size whatever the aspect -- and the frame is a 9-slice, which fits either. `picture` names this theme's own plate, authored at the horizontal bar's 101x24 with the very hole the client's frame has at (22,7)-(97,17), so trough and fill show through it. It REPLACES the blit, so the per-meter glyph the server's art carried -- the heart, the lightning -- is gone and what tells the bars apart is the fill colour. Drop this one property to have them back. A VERTICAL bar is 15x93 and wears the same plate stretched, which is the price of one key covering both shapes. It also dresses the Actionbars addon, which knows nothing about themes: that addon NAMES its bar and its squares and DECLARES what they look like by default, and a declaration sits under every rule -- so one step is enough here, with no chaining and no dependence on which sheet loaded first.",
  "rules": {
    "*": {"font": {"builtin": "sans", "size": 10, "aa": true}},

    "window.title": {
      "font": {"builtin": "mono", "size": 12, "bold": true, "aa": true},
      "emboss": false,
      "glow": {"color": {"r": 12, "g": 90, "b": 105}, "radius": 2},
      "color": {"r": 34, "g": 232, "b": 245},
      "bg": {"color": {"r": 0, "g": 0, "b": 0, "a": 0}}
    },

    "window.frame": {
      "bg": {"asset": "themes/cyberpunk/wallpaper.png", "mode": "tile"},
      "border": {
        "asset": "themes/cyberpunk/frame.png",
        "slice": [5, 20, 5, 5],
        "mode": "stretch",
        "parts": [
          {"asset": "themes/cyberpunk/bracket-tl.png", "at": "topleft"},
          {"asset": "themes/cyberpunk/bracket-tr.png", "at": "topright"},
          {"asset": "themes/cyberpunk/bracket-bl.png", "at": "bottomleft"},
          {"asset": "themes/cyberpunk/bracket-br.png", "at": "bottomright"}
        ]
      },
      "padding": [6, 4, 6, 6],
      "caption": {"at": "topleft", "offset": [8, 3]},
      "sizer": {"asset": "themes/cyberpunk/sizer.png", "at": "bottomright", "offset": [-3, -3]},
      "closeButton": {
        "asset": "themes/cyberpunk/close.png",
        "hover": {"asset": "themes/cyberpunk/close-hover.png"},
        "pressed": {"asset": "themes/cyberpunk/close-pressed.png"},
        "at": "topright",
        "offset": [-5, 3]
      }
    },

    "panel": {
      "bg": {"color": {"r": 15, "g": 21, "b": 36, "a": 242}},
      "border": {"asset": "themes/cyberpunk/panel.png", "slice": [4, 4, 4, 4], "mode": "stretch"}
    },

    "heading": {
      "font": {"builtin": "mono", "size": 16, "bold": true, "aa": true},
      "emboss": {"texture": {"asset": "themes/cyberpunk/emboss.png"}},
      "glow": {"color": {"r": 10, "g": 70, "b": 90}, "radius": 2}
    },

    "button": {
      "font": {"builtin": "mono", "size": 11, "bold": true, "aa": true},
      "emboss": false,
      "glow": {"color": {"r": 6, "g": 40, "b": 52}, "radius": 1},
      "color": {"r": 34, "g": 232, "b": 245},
      "bg": {
        "asset": "themes/cyberpunk/button.png",
        "mode": "stretch",
        "hover": {"asset": "themes/cyberpunk/button-hover.png", "mode": "stretch"},
        "pressed": {"asset": "themes/cyberpunk/button-pressed.png", "mode": "stretch"}
      },
      "border": {"asset": "themes/cyberpunk/btn-frame.png", "slice": [4, 4, 4, 4], "mode": "stretch"}
    },

    "label": {"font": {"builtin": "mono", "size": 11, "aa": true}, "color": {"r": 170, "g": 225, "b": 238}},

    "textentry": {
      "font": {"builtin": "mono", "size": 11, "aa": true},
      "color": {"r": 150, "g": 245, "b": 255},
      "bg": {"asset": "themes/cyberpunk/field.png", "mode": "stretch"},
      "border": {"asset": "themes/cyberpunk/field-frame.png", "slice": [5, 4, 5, 4], "mode": "stretch"},
      "padding": [5, 2, 5, 2]
    },

    "tooltip": {
      "font": {"builtin": "mono", "size": 11, "aa": true},
      "color": {"r": 255, "g": 196, "b": 0},
      "bg": {"color": {"r": 7, "g": 11, "b": 19, "a": 242}},
      "border": {"asset": "themes/cyberpunk/tip.png", "slice": [4, 4, 4, 4], "mode": "stretch"},
      "padding": [4, 2, 4, 2]
    },

    "inventory.slot": {"bg": {"asset": "themes/cyberpunk/slot.png", "mode": "stretch"}},

    "checkbox": {
      "bg": {
        "asset": "themes/cyberpunk/check.png",
        "mode": "stretch",
        "checked": {"asset": "themes/cyberpunk/check-on.png", "mode": "stretch"}
      }
    },

    "checkbox.mark": {"bg": {"asset": "themes/cyberpunk/check-mark.png", "mode": "stretch"}},

    "scrollbar": {"bg": {"asset": "themes/cyberpunk/rail-v.png", "mode": "stretch"}},

    "scrollbar.knob": {"bg": {"asset": "themes/cyberpunk/knob.png", "mode": "stretch"}},

    "slider": {"bg": {"asset": "themes/cyberpunk/rail-h.png", "mode": "stretch"}},

    "slider.knob": {"bg": {"asset": "themes/cyberpunk/knob.png", "mode": "stretch"}},

    "meter": {
      "bg": {"asset": "themes/cyberpunk/meter-trough.png", "mode": "tile"},
      "border": {"asset": "themes/cyberpunk/meter-frame.png", "slice": [3, 3, 3, 3], "mode": "stretch"},
      "picture": {"asset": "themes/cyberpunk/meter-plate.png", "mode": "stretch"}
    },

    "hud.belt": {"picture": {"asset": "themes/cyberpunk/plate-belt.png", "mode": "stretch"}},

    "hud.menu.left": {"picture": {"asset": "themes/cyberpunk/plate-menu-left.png", "mode": "stretch"}},

    "hud.menu.right": {"picture": {"asset": "themes/cyberpunk/plate-menu-right.png", "mode": "stretch"}},

    "hud.search": {"picture": {"asset": "themes/cyberpunk/plate-search.png", "mode": "stretch"}},

    "minimap.frame": {"picture": {"asset": "themes/cyberpunk/minimap-frame.png", "mode": "stretch"}},

    "menu": {
      "font": {"builtin": "mono", "size": 11, "bold": true, "aa": true},
      "color": {"r": 34, "g": 232, "b": 245}
    },

    "menu.slot": {"bg": {"asset": "themes/cyberpunk/menu-slot.png", "mode": "stretch"}},

    "menu.frame": {"picture": {"asset": "themes/cyberpunk/menu-frame.png", "mode": "stretch"}},

    "chat": {"font": {"builtin": "mono", "size": 11, "aa": true}, "color": {"r": 150, "g": 225, "b": 240}},

    "chat.frame": {
      "bg": {"asset": "themes/cyberpunk/wallpaper.png", "mode": "tile"},
      "border": {
        "asset": "themes/cyberpunk/chat-frame.png",
        "slice": [8, 14, 8, 6],
        "mode": "stretch",
        "parts": [{"asset": "themes/cyberpunk/chat-ornament.png", "at": "top"}]
      }
    },

    "chat.log": {"bg": {"color": {"r": 5, "g": 8, "b": 14, "a": 200}}, "border": null},

    "chat.system": {"color": {"r": 255, "g": 196, "b": 0}},

    "chat.mine": {"color": {"r": 255, "g": 45, "b": 149}},

    "chat.private": {"color": {"r": 165, "g": 110, "b": 255}},

    "chat.party": {"color": {"r": 60, "g": 240, "b": 180}},

    "chat.urgent": {
      "color": {
        "palette": [{"r": 34, "g": 232, "b": 245}, {"r": 255, "g": 196, "b": 0}, {"r": 255, "g": 45, "b": 149}]
      }
    },

    "chat.speaker": {"color": {"generate": {"step": 0.29, "saturation": 0.72, "brightness": 1}}},

    "world.nick": {
      "font": {"builtin": "mono", "size": 11, "bold": true, "aa": true},
      "color": {"r": 34, "g": 232, "b": 245}
    },

    "world.speech": {
      "font": {"builtin": "mono", "size": 10, "aa": true},
      "border": {"asset": "themes/cyberpunk/bubble.png", "slice": [5, 5, 5, 5], "mode": "stretch"}
    },

    "[name=actionbars/bar]": {
      "bg": {"color": {"r": 9, "g": 13, "b": 22, "a": 224}},
      "border": {"asset": "themes/cyberpunk/panel.png", "slice": [4, 4, 4, 4], "mode": "stretch"}
    },

    "[name^=actionbars/slot]": {"bg": {"asset": "themes/cyberpunk/menu-slot.png", "mode": "stretch"}}
  }
}
