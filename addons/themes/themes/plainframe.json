{
  "name": "Plain Frame",
  "author": "brodgar",
  "description": "The client's own look with no blackletter: every window wears the plain box frame, and every fraktur site is set in the client's serif.",
  "about": "default.json copied key for key, with TWO changes. THE FRAME: window.frame wears `gfx/hud/wnd`, the eight-piece box the client already paves its inventory squares, its portrait and the action bars with, tiled the way the client tiles it. A border replaces the stock frame art AND its insets, so the two properties beside it are the geometry that art no longer supplies -- `padding` is the whole margin between the box and the content, and `caption` is where the title sits now that the carved plate the stock frame draws it on is gone. THE TEXT: the three keys the client sets in fraktur -- window.title, heading and label -- are set in `serif` instead, at sizes a little under the fraktur ones because a serif reads larger at the same number and a row height was measured at the stock size. Every other key is default.json's value, which is what the client itself draws with; null means the client sets none there. Two fraktur sites are out of reach of any sheet and stay blackletter: the character-selection names and the item-stock counts, neither of which renders through a site key.",
  "rules": {
    "*": {
      "font": {"builtin": "sans", "size": 10, "aa": false},
      "color": null,
      "emboss": null,
      "glow": null,
      "bg": null,
      "border": null,
      "padding": null,
      "picture": null
    },

    "window.title": {
      "font": {"builtin": "serif", "size": 14, "aa": true},
      "color": null,
      "emboss": {"texture": {"res": "gfx/hud/fonttex"}},
      "glow": null,
      "bg": null,
      "border": null
    },

    "window.frame": {
      "bg": [
        {"res": "gfx/hud/wnd/lg/bg", "mode": "tile"},
        {"res": "gfx/hud/wnd/lg/bgl", "at": "left", "mode": "tile"},
        {"res": "gfx/hud/wnd/lg/bgr", "at": "right", "mode": "tile"}
      ],
      "border": {"box": "gfx/hud/wnd", "mode": "tile"},
      "padding": [6, 20, 6, 6],
      "caption": {"at": "topleft", "offset": [10, 4]},
      "sizer": null,
      "closeButton": {
        "res": "gfx/hud/wnd/lg/cbtnu",
        "hover": {"res": "gfx/hud/wnd/lg/cbtnh", "mode": "stretch"},
        "pressed": {"res": "gfx/hud/wnd/lg/cbtnd", "mode": "stretch"},
        "at": "topright",
        "mode": "stretch"
      }
    },

    "panel": {"bg": null, "border": null},

    "heading": {
      "font": {"builtin": "serif", "size": 21, "aa": true},
      "color": null,
      "emboss": null,
      "glow": null
    },

    "button": {
      "font": {"builtin": "serif", "size": 12, "bold": true, "aa": true},
      "color": null,
      "emboss": {"texture": {"res": "gfx/hud/fonttex"}},
      "glow": null,
      "bg": null,
      "border": null
    },

    "label": {"font": {"builtin": "serif", "size": 15, "aa": true}, "color": null},

    "textentry": {
      "font": {"builtin": "serif", "size": 12, "aa": true},
      "color": null,
      "bg": {"res": "gfx/hud/text/m", "mode": "stretch"},
      "border": null,
      "padding": null
    },

    "tooltip": {
      "font": {"builtin": "sans", "size": 10, "aa": false},
      "color": null,
      "bg": null,
      "border": null,
      "padding": null
    },

    "inventory.slot": {"bg": null, "border": null},

    "checkbox": {"bg": null, "border": null},

    "checkbox.mark": {"bg": null, "border": null},

    "scrollbar": {"bg": null, "border": null},

    "scrollbar.knob": {"bg": {"res": "gfx/hud/sflarp", "mode": "stretch"}, "border": null},

    "slider": {"bg": null, "border": null},

    "slider.knob": {"bg": {"res": "gfx/hud/sflarp", "mode": "stretch"}, "border": null},

    "meter": {"bg": null, "border": null, "picture": null},

    "hud.belt": {"picture": {"res": "gfx/hud/hb-main", "mode": "stretch"}},

    "hud.menu.left": {"picture": {"res": "gfx/hud/lbtn-bg", "mode": "stretch"}},

    "hud.menu.right": {"picture": {"res": "gfx/hud/rbtn-bg", "mode": "stretch"}},

    "hud.search": {"picture": {"res": "gfx/hud/csearch-bg", "mode": "stretch"}},

    "minimap.frame": {"picture": {"res": "gfx/hud/blframe", "mode": "stretch"}},

    "menu": {"font": {"builtin": "sans", "size": 12, "aa": false}, "color": null},

    "menu.slot": {"bg": null, "border": null},

    "menu.frame": {"picture": {"res": "gfx/hud/brframe", "mode": "stretch"}},

    "chat": {"font": {"builtin": "sans", "size": 12, "aa": false}, "color": null},

    "chat.frame": {"bg": {"res": "gfx/hud/wnd/lg/bg", "mode": "tile"}, "border": null},

    "chat.log": {"bg": {"color": {"r": 0, "g": 0, "b": 0, "a": 128}}, "border": null},

    "chat.system": {"font": null, "color": null},

    "chat.mine": {"font": null, "color": null},

    "chat.private": {"font": null, "color": null},

    "chat.party": {"font": null, "color": null},

    "chat.urgent": {
      "color": {
        "palette": [
          {"r": 0, "g": 128, "b": 255, "a": 255},
          {"r": 255, "g": 128, "b": 0, "a": 255},
          {"r": 255, "g": 0, "b": 0, "a": 255}
        ]
      }
    },

    "chat.speaker": {"color": {"generate": {"step": 0.41421356237309515, "saturation": 0.5, "brightness": 1}}},

    "world.nick": {"font": {"builtin": "sans", "size": 12, "bold": true, "aa": true}, "color": null},

    "world.speech": {
      "font": {"builtin": "sans", "size": 10, "aa": false},
      "bg": null,
      "border": {"box": "gfx/hud/emote", "mode": "stretch"}
    }
  }
}
