<?xml version="1.0" ?>

<project name="hafen" default="deftgt" xmlns:if="ant:if">
  <property file="build.properties" />
  <property name="ext-lib-base" value="http://www.havenandhearth.com/java" />
  <!-- addon: the maintainer's addons live in their own repository, brodgar-io-client-addons, checked out
       beside this one. bin/ (the sandbox) takes every addon it holds; a release takes only the ones
       etc/release-addons names. Override with an `addons.repo=` line in build.properties. -->
  <property name="addons.repo" value="../brodgar-io-client-addons" />
  <!-- addon: the version is what publish.ps1 passes (-Dversion=1.2.3) and `dev` for every other build. -->
  <property name="version" value="dev" />

  <target name="build-env">
    <mkdir dir="build" />
    <mkdir dir="build/classes" />
    <available property="has-res-jar" file="bin/builtin-res.jar" />
    <available property="unpacked-lib" file="build/classes-lib" />
    <condition property="has-panama">
      <javaversion atleast="22" />
    </condition>
  </target>

  <target name="make-buildinfo" depends="build-env">
    <touch file="build/classes/buildinfo" datetime="01/01/2000 12:00 am" />
    <loadproperties srcFile="build/classes/buildinfo" prefix="buildinfo." />
    <exec executable="git" outputproperty="git-rev" failifexecutionfails="false">
      <arg line="rev-parse HEAD" />
    </exec>
    <condition property="buildinfo-unchanged">
      <and>
	<equals arg1="${buildinfo.git-rev}" arg2="${git-rev}" />
	<equals arg1="${buildinfo.version}" arg2="${version}" />   <!-- addon: the version is recorded too -->
      </and>
    </condition>
  </target>

  <!-- addon: `version` lands in the jar's buildinfo beside the git revision, where the error reporter already
       reads it. -->
  <target name="buildinfo" depends="make-buildinfo" unless="buildinfo-unchanged">
    <echo message="Updating buildinfo" />
    <echo file="build/classes/buildinfo" xml:space="default">
      git-rev = ${git-rev}
      version = ${version}
    </echo>
  </target>


  <macrodef name="extlib">
    <attribute name="name" />
    <attribute name="path" />
    <attribute name="url" />
    <sequential>
      <local name="@{name}-files" />
      <mkdir dir="@{path}" />
      <loadresource property="@{name}-files">
	<url url="@{url}/lib-files" />
	<filterchain>
	  <prefixlines prefix="@{url}/" />
	</filterchain>
      </loadresource>
      <get dest="@{path}/" usetimestamp="true">
	<resourcelist>
	  <propertyresource name="@{name}-files" />
	</resourcelist>
      </get>
      <touch file="@{path}/has-@{name}" />
    </sequential>
  </macrodef>

  <target name="extlib-env">
    <mkdir dir="lib/ext" />
    <available property="extlib/has-jogl" file="lib/ext/jogl/has-jogl" />
    <available property="extlib/has-lwjgl-base" file="lib/ext/lwjgl/has-lwjgl-base" />
    <available property="extlib/has-lwjgl-gl" file="lib/ext/lwjgl/has-lwjgl-gl" />
    <available property="extlib/has-steamworks" file="lib/ext/steamworks/has-steamworks" />
  </target>

  <target name="extlib/jogl" depends="extlib-env" unless="extlib/has-jogl">
    <extlib name="jogl" path="lib/ext/jogl" url="${ext-lib-base}/jogl/current" />
  </target>

  <target name="extlib/lwjgl-base" depends="extlib-env" unless="extlib/has-lwjgl-base">
    <extlib name="lwjgl-base" path="lib/ext/lwjgl" url="${ext-lib-base}/lwjgl/current/lwjgl" />
  </target>

  <target name="extlib/lwjgl-gl" depends="extlib-env, extlib/lwjgl-base" unless="extlib/has-lwjgl-gl">
    <extlib name="lwjgl-gl" path="lib/ext/lwjgl" url="${ext-lib-base}/lwjgl/current/lwjgl-opengl" />
  </target>

  <target name="extlib/steamworks" depends="extlib-env" unless="extlib/has-steamworks">
    <extlib name="steamworks" path="lib/ext/steamworks" url="${ext-lib-base}/steamworks/current" />
  </target>


  <target name="get-luaj" depends="build-env">
    <!-- addon engine: fetch the LuaJ runtime into lib/brodgar/ (not committed; specs D-014). -->
    <mkdir dir="lib/brodgar" />
    <get src="https://repo1.maven.org/maven2/org/luaj/luaj-jse/3.0.1/luaj-jse-3.0.1.jar"
	 dest="lib/brodgar/luaj-jse-3.0.1.jar" skipexisting="true" />
  </target>

  <!-- addon: the two third-party halves of the voice engine (src/io/brodgar/voice/**), fetched like LuaJ and
       not committed. Concentus is the pure-Java Opus codec, pinned to one commit of lostromb/concentus on
       JitPack (it is on no Maven repository); minimal-json is the wire codec's JSON. -->
  <target name="get-concentus" depends="build-env">
    <mkdir dir="lib/brodgar" />
    <get src="https://jitpack.io/com/github/lostromb/concentus/Concentus/17318837bf/Concentus-17318837bf.jar"
	 dest="lib/brodgar/Concentus-17318837bf.jar" skipexisting="true" />
  </target>

  <target name="get-minimal-json" depends="build-env">
    <mkdir dir="lib/brodgar" />
    <get src="https://repo1.maven.org/maven2/com/eclipsesource/minimal-json/minimal-json/0.9.5/minimal-json-0.9.5.jar"
	 dest="lib/brodgar/minimal-json-0.9.5.jar" skipexisting="true" />
  </target>

  <!-- addon: the store's engine (src/io/brodgar/addon/SqliteApi.java), fetched like LuaJ and not committed.
       One jar, no runtime dependency (slf4j is optional and absent: the driver logs through java.util.logging
       then), the natives for every platform inside it, extracted to java.io.tmpdir on first open. -->
  <target name="get-sqlite" depends="build-env">
    <mkdir dir="lib/brodgar" />
    <get src="https://repo1.maven.org/maven2/org/xerial/sqlite-jdbc/3.53.4.0/sqlite-jdbc-3.53.4.0.jar"
	 dest="lib/brodgar/sqlite-jdbc-3.53.4.0.jar" skipexisting="true" />
  </target>

  <target name="hafen-client" depends="build-env, extlib/jogl, extlib/lwjgl-gl, extlib/steamworks, get-luaj, get-concentus, get-minimal-json, get-sqlite">
    <condition property="explicit-annotations">
      <javaversion atleast="21" />
    </condition>
    <javac srcdir="src" destdir="build/classes" debug="on"
	   source="1.8" target="1.8" includeantruntime="no"
	   bootclasspath="${boot-classpath}">
      <classpath>
	<pathelement path="lib/ext/jogl/jogl-all.jar" />
	<pathelement path="lib/ext/jogl/gluegen-rt.jar" />
	<pathelement path="lib/ext/lwjgl/lwjgl-fat.jar" />
	<pathelement path="lib/ext/lwjgl/lwjgl-awt.jar" />
	<pathelement path="lib/ext/lwjgl/lwjgl-opengl-fat.jar" />
	<pathelement path="lib/ext/steamworks/steamworks4j.jar" />
	<pathelement path="lib/jglob.jar" />
	<fileset dir="lib/brodgar" includes="*.jar" />
      </classpath>
      <compilerarg if:set="explicit-annotations" value="-proc:full" />
      <compilerarg value="-Xlint:unchecked" />
      <compilerarg value="-Xlint:deprecation" />
      <compilerarg value="-Xlint:-options" />
      <!-- <compilerarg value="-Xbarda" /> -->
    </javac>
    <copy todir="build/classes">
      <fileset dir="src" excludes="**/*.java" />
    </copy>
    <copy todir="build/classes/haven" file="etc/ressrv.crt" />
    <copy todir="build/classes/haven" file="etc/authsrv.crt" />
    <copy todir="build/classes/haven" file="etc/res-preload" />
    <copy todir="build/classes/haven" file="etc/res-bgload" />
    <copy todir="build/classes/haven" file="etc/icon.png" />
    <copy file="local-boot.properties" tofile="build/classes/haven/boot-props" failonerror="false" quiet="true" />
  </target>

  <target name="opt/panama" if="has-panama" depends="build-env, hafen-client">
    <mkdir dir="build/opt/panama" />
    <javac srcdir="opt/panama" destdir="build/opt/panama" release="22"
	   debug="on" includeantruntime="no">
      <classpath>
	<pathelement path="build/classes" />
	<pathelement path="lib/jglob.jar" />
      </classpath>
      <compilerarg value="-proc:full" />
      <compilerarg value="-Xlint:unchecked" />
      <compilerarg value="-Xlint:deprecation" />
    </javac>
    <jar destfile="build/hafen-panama.jar" update="true">
      <fileset dir="build/opt/panama" />
    </jar>
  </target>

  <target name="lib-classes" depends="build-env" unless="unpacked-lib">
    <mkdir dir="build/classes-lib" />
    <unjar src="lib/jglob.jar" dest="build/classes-lib">
      <patternset excludes="META-INF/**" />
    </unjar>
  </target>

  <target name="jar" depends="hafen-client, buildinfo, lib-classes">
    <jar destfile="build/hafen.jar" update="true">
      <fileset dir="build/classes" />
      <fileset dir="build/classes-lib" />
      <manifest>
	<attribute name="Main-Class" value="haven.Client" />
	<attribute name="Class-Path" value="hafen-panama.jar builtin-res.jar hafen-res.jar brodgar-res.jar lib/jogl-all.jar lib/gluegen-rt.jar lib/lwjgl-fat.jar lib/lwjgl-awt.jar lib/lwjgl-opengl-fat.jar lib/steamworks4j.jar lib/luaj-jse-3.0.1.jar lib/Concentus-17318837bf.jar lib/minimal-json-0.9.5.jar lib/sqlite-jdbc-3.53.4.0.jar" />
	<attribute name="Add-Exports" value="java.base/java.lang java.desktop/sun.awt java.desktop/sun.java2d" />
	<attribute name="Enable-Native-Access" value="ALL-UNNAMED" />
      </manifest>
    </jar>
    <chmod file="build/hafen.jar" perm="a+x" />
  </target>

  <target name="res-jar" depends="build-env" unless="has-res-jar">
    <get src="${ext-lib-base}/builtin-res.jar" dest="lib/ext/builtin-res.jar"
	 usetimestamp="true" />
    <get src="${ext-lib-base}/hafen-res.jar" dest="lib/ext/hafen-res.jar"
	 usetimestamp="true" />
    <available property="lib-res-jar" file="lib/ext/hafen-res.jar" />
    <fail unless="lib-res-jar" message="hafen-res.jar not available" />
    <available property="lib-builtin-jar" file="lib/ext/builtin-res.jar" />
    <fail unless="lib-builtin-jar" message="builtin-res.jar not available" />
  </target>

  <target name="jars" depends="build-env, jar, extlib/jogl, extlib/lwjgl-gl, extlib/steamworks">
    <copy todir="build" failonerror="false" quiet="true">
      <fileset dir="lib">
	<include name="builtin-res.jar" />
	<include name="hafen-res.jar" />
      </fileset>
    </copy>
    <copy todir="build">
      <fileset dir="lib/ext/jogl"><include name="*.jar" /></fileset>
      <fileset dir="lib/ext/lwjgl"><include name="*.jar" /></fileset>
      <fileset dir="lib/ext/steamworks"><include name="*.jar" /></fileset>
    </copy>
    <copy file="local-config.properties" tofile="build/haven-config.properties" failonerror="false" quiet="true" />
  </target>

  <target name="bin" depends="jar, extlib/jogl, extlib/lwjgl-gl, extlib/steamworks, res-jar">
    <mkdir dir="bin" />
    <copy todir="bin">
      <fileset dir="build">
	<include name="hafen.jar" />
      </fileset>
      <fileset dir="lib/ext">
	<include name="hafen-res.jar" />
	<include name="builtin-res.jar" />
      </fileset>
    </copy>
    <copy todir="bin/lib">
      <fileset dir="lib/ext/jogl"><include name="*.jar" /></fileset>
      <fileset dir="lib/ext/lwjgl"><include name="*.jar" /></fileset>
      <fileset dir="lib/ext/steamworks"><include name="*.jar" /></fileset>
      <fileset dir="lib/brodgar"><include name="*.jar" /></fileset>
    </copy>
    <!-- addon: the suite in flight (addons/ holds nothing else), and every addon of the maintainer's from
         the sibling checkout; the repository's own README stays behind, an addon's own README goes. -->
    <copy todir="bin/addons" failonerror="false" quiet="true">
      <fileset dir="addons" />
    </copy>
    <copy todir="bin/addons" failonerror="false" quiet="true">
      <fileset dir="${addons.repo}" excludes="README.md,LICENSE*" />
    </copy>
    <copy todir="bin" failonerror="false" quiet="true">
      <fileset dir="build">
	<include name="hafen-panama.jar" />
      </fileset>
    </copy>
    <copy file="etc/ansgar-config.properties" tofile="bin/haven-config.properties" />
    <fixcrlf srcdir="etc" includes="run.bat" destdir="bin" eol="crlf" />
    <!-- addon: the Steam app id, read by the Steamworks SDK from the working directory when the client is
         not started by Steam. Beside hafen.jar because that folder IS the working directory of every start
         (run.bat cd's there; the launcher starts the client in client/): it is what lets the login screen's
         Steam button ask the running Steam client for a ticket. The one start with another working directory
         is `ant run`, which sets SteamAppId instead. -->
    <copy file="etc/steam_appid.txt" todir="bin" />
    <chmod file="bin/hafen.jar" perm="a+x" />
  </target>

  <target name="deftgt" depends="jars, opt/panama, bin" />

  <!-- addon: dist/, a self-contained, playable install: what a release is made of. Unlike bin/ (the
       development sandbox, which also carries whatever suite is in flight and every addon of the
       maintainer's), dist/ holds only what the client needs to run: the jars, the resource jars, the
       natives, the server config, the addons etc/release-addons names, and run.bat. Every one of
       those is rebuilt from scratch, so an addon struck from the list leaves nothing of itself
       behind. savedata/ is the one exception, because it is the store of whoever plays from this
       folder and the build has no business in it. A folder handed to someone else is zipped WITHOUT
       savedata/. -->
  <target name="dist" depends="deftgt">
    <mkdir dir="dist" />
    <delete includeemptydirs="true">
      <fileset dir="dist" includes="**/*" excludes="savedata/**" defaultexcludes="no" />
    </delete>
    <copy todir="dist">
      <fileset dir="build">
	<include name="hafen.jar" />
      </fileset>
      <fileset dir="lib/ext">
	<include name="hafen-res.jar" />
	<include name="builtin-res.jar" />
      </fileset>
    </copy>
    <copy todir="dist" failonerror="false" quiet="true">
      <fileset dir="build">
	<include name="hafen-panama.jar" />
      </fileset>
    </copy>
    <copy todir="dist/lib">
      <fileset dir="lib/ext/jogl"><include name="*.jar" /></fileset>
      <fileset dir="lib/ext/lwjgl"><include name="*.jar" /></fileset>
      <fileset dir="lib/ext/steamworks"><include name="*.jar" /></fileset>
      <fileset dir="lib/brodgar"><include name="*.jar" /></fileset>
    </copy>
    <!-- The addons a release ships are the ids etc/release-addons lists, one per line, taken from the
         sibling checkout; the suite in flight under addons/ never ships. The list is read into one
         includes pattern (`id/**,` per line) and an empty list sets no property, so nothing is copied;
         a bare includes="" would take the whole checkout. -->
    <loadfile property="release-addons" srcFile="etc/release-addons" failonerror="false" quiet="true">
      <filterchain>
	<striplinecomments><comment value="#" /></striplinecomments>
	<tokenfilter><trim /><ignoreblank /></tokenfilter>
	<suffixlines suffix="/**," />
	<striplinebreaks />
      </filterchain>
    </loadfile>
    <copy todir="dist/addons" failonerror="false" quiet="true" if:set="release-addons">
      <fileset dir="${addons.repo}" includes="${release-addons}" />
    </copy>
    <copy file="etc/ansgar-config.properties" tofile="dist/haven-config.properties" />
    <fixcrlf srcdir="etc" includes="run.bat" destdir="dist" eol="crlf" />
    <copy file="etc/steam_appid.txt" todir="dist" />
    <chmod file="dist/hafen.jar" perm="a+x" />
    <echo message="Client ready in dist/ -- double-click dist\run.bat to play." />
  </target>

  <!-- addon: the release asset publish.ps1 uploads: dist/ without savedata/, the client at the zip's root,
       named by the version. ant's own zip task, so every entry is written with `/` (PowerShell 5.1's
       Compress-Archive writes `\`, which the launcher refuses as a path it cannot trust). -->
  <target name="release" depends="dist">
    <zip destfile="build/brodgar.io-client-v${version}.zip" basedir="dist" excludes="savedata/**" />
    <echo message="Release asset: build/brodgar.io-client-v${version}.zip" />
  </target>


  <target name="run" depends="deftgt">
    <condition property="jogl-exports">
      <javaversion atleast="16" />
    </condition>
    <condition property="jogl-access">
      <javaversion atleast="24" />
    </condition>
    <!-- addon: GC tuning. The client allocates ~11 MB per frame (measured with 019's profiler), so the
	 default collector on the default max heap (a quarter of physical RAM) collects rarely and LONG:
	 a ~70 ms stop-the-world pause every ~2 s, felt as a stutter and visible as one red bar in the
	 profiler's frame graph. A FIXED, pre-committed heap plus generational ZGC does not reduce the
	 garbage, it removes the stall (ZGC collects concurrently, sub-millisecond pauses). Cost: `heap`
	 is committed at startup, so launching takes a moment longer and the process reserves that RSS.
	 Override with -Dheap=8g on the command line, or a `heap=` line in build.properties. -->
    <property name="heap" value="4g" />
    <condition property="zgc">
      <javaversion atleast="21" />
    </condition>
    <condition property="zgc-generational">   <!-- opt-in on 21-23; the default (and obsolete flag) from 24 -->
      <and>
	<javaversion atleast="21" />
	<not><javaversion atleast="24" /></not>
      </and>
    </condition>
    <!-- macOS ships no arm64 JOGL native, so the client would fall through to the LWJGL AWT
	 canvas, which draws on the AWT event thread and gets the process killed by AppKit
	 (`-[NSOpenGLContext setView:] must be called from the main thread`). The Cocoa/CGL
	 toolkit is native and dispatches its context calls to the real main thread; it is already
	 the highest-priority choice and only misses auto-selection by declaring itself
	 experimental, which naming it explicitly bypasses. It ships in hafen-panama.jar, hence
	 the Java 22 guard. Override with -Dtoolkit=jogl, or a `toolkit=` line in
	 build.properties. -->
    <condition property="toolkit" value="cgl">
      <and>
	<os family="mac" />
	<javaversion atleast="22" />
      </and>
    </condition>
    <java jar="bin/hafen.jar" fork="true">
      <jvmarg value="-Xms${heap}" />
      <jvmarg value="-Xmx${heap}" />
      <jvmarg value="-XX:+AlwaysPreTouch" />
      <jvmarg if:set="zgc" value="-XX:+UseZGC" />
      <jvmarg if:set="zgc-generational" value="-XX:+ZGenerational" />
      <sysproperty key="sun.java2d.uiScale.enabled" value="false" />
      <sysproperty key="java.net.preferIPv6Addresses" value="system" />
      <sysproperty if:set="toolkit" key="haven.toolkit" value="${toolkit}" />
      <!-- addon: the hub the AddOns manager's Browse tab reads from. `ant -Dregistry=http://localhost:3730/addons/api run`
           points a development client at a local hub; unset, the client reads brodgar.io/addons. -->
      <sysproperty if:set="registry" key="haven.addon.registry" value="${registry}" />
      <!-- addon: the on-disk store. `ant -Dstore=sqlite run` keeps the map and the resource cache in savedata/*.sqlite;
           unset (or `files`), the client uses HashDirCache under %APPDATA% as upstream does. -->
      <sysproperty if:set="store" key="haven.store" value="${store}" />
      <!-- addon: the development run's working directory is this folder, not bin/, so the Steamworks SDK
           would not find bin/steam_appid.txt; the environment variable Steam itself sets says the same. -->
      <env key="SteamAppId" value="3051280" />
      <jvmarg if:set="jogl-exports" value="--add-exports=java.base/java.lang=ALL-UNNAMED" />
      <jvmarg if:set="jogl-exports" value="--add-exports=java.desktop/sun.awt=ALL-UNNAMED" />
      <jvmarg if:set="jogl-exports" value="--add-exports=java.desktop/sun.java2d=ALL-UNNAMED" />
      <jvmarg if:set="jogl-access" value="--enable-native-access=ALL-UNNAMED" />
      <!-- <sysproperty key="haven.renderer" value="lwjgl" /> -->
      <!-- addon: the development run reads resources from the brodgar.io resource cache. It is the ONE
           place that passes -U: the client's own default is the game's server (haven.resurl in the shipped
           haven-config.properties), run.bat passes no -U, and the launcher rewrites that line of the shipped
           file from its checkbox, so the file says what is in force. -->
      <arg value="-U" />
      <arg value="https://res.brodgar.io/" />
    </java>
  </target>

  <target name="clean">
    <delete dir="build" />
    <delete dir="lib/ext" />
    <!-- addon: bin/ is a build product apart from bin/savedata/, which is the addon store of the
	 characters played from the development sandbox. A clean takes the build, not the player. -->
    <mkdir dir="bin" />
    <delete includeemptydirs="true">
      <fileset dir="bin" includes="**/*" excludes="savedata/**" defaultexcludes="no" />
    </delete>
  </target>
</project>
